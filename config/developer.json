{
  "$schema": "./schema.json",
  "profile": "developer",
  "applications": [
    "git",
    "pwsh",
    "windows-terminal",
    "vscode",
    "github-cli"
  ],
  "settings": {
    "logLevel": "INFO",
    "createBackups": true
  },
  "git": {
    "enabled": true,
    "defaultBranch": "main",
    "pullRebase": "true",
    "credentialHelper": "manager"
  },
  "fonts": ["CascadiaCode"],
  "folders": ["Dev\\Projects", "Dev\\OpenSource"],
  "environment": {
    "user": { "EDITOR": "code" },
    "path": ["%USERPROFILE%\\bin"]
  }
}
