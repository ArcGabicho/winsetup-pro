<UserControl x:Class="WinSetup.Pro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WinSetup.Pro.UI.Views">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">

        <TextBlock Style="{StaticResource H1}" Text="Prepare your Windows workstation" />
        <TextBlock Style="{StaticResource Muted}"
                   Text="Choose how to configure this PC. Nothing is changed until you review and confirm." />

        <!-- Resume banner -->
        <Border Style="{StaticResource CardPanel}" Margin="0,16,0,0"
                BorderBrush="{DynamicResource Warn}"
                Visibility="{Binding ShowResume, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Previous setup detected" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Journal.Profile, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Journal.Counts.Completed, Mode=OneWay}" /><Run Text=" done, " /><Run Text="{Binding Journal.Counts.Pending, Mode=OneWay}" /><Run Text=" pending, " /><Run Text="{Binding Journal.Counts.Failed, Mode=OneWay}" /><Run Text=" failed" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource Primary}" Content="Resume setup" Command="{Binding ResumeCommand}" />
                    <Button Content="Dismiss" Margin="8,0,0,0" Command="{Binding DismissResumeCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <WrapPanel Margin="0,16,0,0">
            <Button Style="{StaticResource Primary}" Content="Choose a profile" Width="180" Height="44"
                    Margin="0,0,10,10" Command="{Binding StartCommand}" />
            <Button Content="Build a custom setup" Width="180" Height="44"
                    Margin="0,0,10,10" Command="{Binding CustomCommand}" />
        </WrapPanel>

        <!-- System card -->
        <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="This machine" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Text="Windows" Margin="0,2,16,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding System.OsCaption}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="PowerShell" Margin="0,2,16,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding System.PsVersion}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="winget" Margin="0,2,16,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding System.WingetVersion}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="WSL" Margin="0,2,16,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding System.WslPresent}" Margin="0,2" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Text="Administrator" Margin="0,2,16,2" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding System.IsAdmin}" Margin="0,2" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
