<UserControl x:Class="WinSetup.Pro.UI.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Review changes" />
        <TextBlock Style="{StaticResource Muted}">
            <Run Text="WinSetup Pro will make " /><Run Text="{Binding ChangeCount, Mode=OneWay}" /><Run Text=" change(s). Nothing has been touched yet." />
        </TextBlock>

        <CheckBox Content="Dry run - preview only, make no changes" IsChecked="{Binding DryRun}"
                  Foreground="{DynamicResource Fg}" Margin="0,12,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding Installs.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Install" />
                <ItemsControl ItemsSource="{Binding Installs}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Margin="0,2"><Run Text="+ " Foreground="{DynamicResource Ok}" /><Run Text="{Binding Name}" /></TextBlock>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                Visibility="{Binding Configures.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Configure" />
                <ItemsControl ItemsSource="{Binding Configures}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Margin="0,2"><Run Text="~ " Foreground="{DynamicResource Accent}" /><Run Text="{Binding Name}" /></TextBlock>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                Visibility="{Binding Backups.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Backup (before modifying)" />
                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2">
                            <Run Text="✓ " Foreground="{DynamicResource Ok}" /><Run Text="{Binding File}" />
                        </TextBlock>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Preserved" />
                <ItemsControl ItemsSource="{Binding Preserve}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2"><Run Text="✓ " Foreground="{DynamicResource Ok}" /><Run Text="{Binding}" /></TextBlock>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0" BorderBrush="{DynamicResource Warn}"
                Visibility="{Binding AdminNeeded.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Requires administrator" />
                <ItemsControl ItemsSource="{Binding AdminNeeded}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Margin="0,2"><Run Text="⚡ " Foreground="{DynamicResource Warn}" /><Run Text="{Binding}" /></TextBlock>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Restart as Administrator" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding RestartElevatedCommand}"
                        Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Style="{StaticResource Primary}" Content="Apply changes" Margin="8,0,0,0"
                    Command="{Binding ApplyCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
