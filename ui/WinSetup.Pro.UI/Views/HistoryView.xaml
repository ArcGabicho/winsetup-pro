<UserControl x:Class="WinSetup.Pro.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <DockPanel>
            <TextBlock Style="{StaticResource H1}" Text="History" />
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Open logs folder"
                    Command="{Binding OpenLogsCommand}" />
        </DockPanel>
        <TextBlock Style="{StaticResource Muted}" Text="The last run journal and recent log files." />

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="14,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}"
                                       Style="{StaticResource Muted}" FontSize="12" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
