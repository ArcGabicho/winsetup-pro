<UserControl x:Class="WinSetup.Pro.UI.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
        <TextBlock Style="{StaticResource Muted}"
                   Text="State comes from the engine's real detection. Tick what you want; leave the rest." />

        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource H2}" Text="{Binding Name}" />
                        <Border Style="{StaticResource CardPanel}" Padding="6">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" />
                                                    <TextBlock Text="  admin" Foreground="{DynamicResource Warn}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                                           Text="{Binding Description}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateGlyph}" Margin="0,0,6,0"
                                                           Foreground="{Binding Info.State, Converter={StaticResource StateToBrush}}" />
                                                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Style="{StaticResource Primary}" Margin="8,0,0,0" Command="{Binding ContinueCommand}">
                <TextBlock><Run Text="Review " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" component(s)" /></TextBlock>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
