<UserControl x:Class="WinSetup.Pro.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource H1}" Text="Settings" />

        <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="General" />
                <CheckBox Content="Show a confirmation before applying changes" Margin="0,4"
                          Foreground="{DynamicResource Fg}" IsChecked="{Binding ConfirmBeforeChanges}" />
                <CheckBox Content="Create backups before modifying configuration" Margin="0,4"
                          Foreground="{DynamicResource Fg}" IsChecked="{Binding CreateBackups}" />
                <CheckBox Content="Check for updates" Margin="0,4"
                          Foreground="{DynamicResource Fg}" IsChecked="{Binding CheckForUpdates}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Logging &amp; appearance" />
                <TextBlock Style="{StaticResource Muted}" Text="Log level" Margin="0,4,0,2" />
                <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Width="180"
                          HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Muted}" Text="Appearance" Margin="0,10,0,2" />
                <ComboBox ItemsSource="{Binding Appearances}" SelectedItem="{Binding Appearance}" Width="180"
                          HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardPanel}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Advanced" />
                <CheckBox Content="Enable developer diagnostics" Margin="0,4"
                          Foreground="{DynamicResource Fg}" IsChecked="{Binding DeveloperDiagnostics}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                    <Run Text="Engine: " /><Run Text="{Binding RepoRoot, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" FontSize="12">
                    <Run Text="PowerShell: " /><Run Text="{Binding PwshPath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
