<Window x:Class="WinSetup.Pro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinSetup.Pro.UI.ViewModels"
        xmlns:v="clr-namespace:WinSetup.Pro.UI.Views"
        Title="WinSetup Pro" Height="720" Width="1080" MinHeight="560" MinWidth="880"
        Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><v:ProfilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComponentsViewModel}"><v:ComponentsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReviewViewModel}"><v:ReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}"><v:RunView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}"><v:ResultView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><v:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Nav rail -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <TextBlock Text="WinSetup Pro" FontFamily="Segoe UI Semibold" FontSize="16"
                               Foreground="{DynamicResource AccentFg}" />
                    <TextBlock Text="Reproducible Windows environments" FontSize="11"
                               Foreground="#8A909B" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
                    <Border Background="#22FFFFFF" CornerRadius="6" Padding="10,7">
                        <StackPanel>
                            <TextBlock Text="{Binding HostBadge}" Foreground="{DynamicResource SidebarFg}" FontSize="12" />
                            <TextBlock Text="This app is not elevated" Foreground="#8A909B" FontSize="10" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" GroupName="nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Dashboard, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Profiles" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Profiles" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Components" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Components" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Diagnostics" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
                    <RadioButton Style="{StaticResource NavButton}" Content="History" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="History" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" GroupName="nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                <ContentControl Content="{Binding Current}" />
            </ScrollViewer>

            <!-- Error bar -->
            <Border VerticalAlignment="Top" Background="{DynamicResource Bad}" Padding="16,10"
                    Visibility="{Binding Current.Error, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Current.Error}" Foreground="White" />
            </Border>

            <!-- Busy overlay -->
            <Border Background="#66000000"
                    Visibility="{Binding Current.IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                 Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" />
                    <TextBlock Text="Working..." Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
